{
  "name": "semantic-defense",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/tests.mjs",
    "typecheck": "pnpm -r exec tsc --noEmit -p .",
    "lint": "eslint .",
    "dup": "jscpd packages",
    "audit": "bash scripts/audit.sh",
    "secrets": "bash scripts/secrets.sh",
    "sbom": "bash scripts/sbom.sh",
    "ci": "bash scripts/ci.sh",
    "gate": "bash scripts/gate.sh",
    "test:once": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^4.2.1",
    "jscpd": "^5.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
