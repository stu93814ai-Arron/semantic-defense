{
  "name": "semantic-defense",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/tests.mjs",
    "typecheck": "bash scripts/typecheck.sh",
    "lint": "eslint .",
    "dup": "jscpd packages $(ls -d apps 2>/dev/null)",
    "audit": "bash scripts/audit.sh",
    "secrets": "bash scripts/secrets.sh",
    "sbom": "bash scripts/sbom.sh",
    "ci": "bash scripts/ci.sh",
    "gate": "bash scripts/gate.sh",
    "test:once": "node scripts/with-pg.mjs vitest run",
    "coverage": "node scripts/with-pg.mjs vitest run --coverage",
    "e2e": "bash scripts/e2e.sh",
    "gate:clean": "bash scripts/gate-clean.sh",
    "boundaries": "node scripts/boundaries.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "jscpd": "^5.4.2",
    "jsdom": "^31.0.0",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
