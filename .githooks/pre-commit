#!/usr/bin/env bash
# 提交前檢查（只驗暫存區／index）：gitleaks → typecheck → eslint --max-warnings=0。
# 用 checkout-index 匯出 index 到暫存目錄再跑，不碰工作目錄、不用 git stash。
# 只有緊急情況才可用 git commit -n 跳過，規範見 docs/ci/hooks.md。
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

TMP=$(mktemp -d "${TMPDIR:-/tmp}/sd-precommit-XXXXXX")
TMP_REAL=$(realpath "$TMP")
# 寫入／刪除 $TMP 子路徑前，確認解析後仍在暫存樹內（防止 index 內 symlink 指到樹外）
assert_under_tmp() {
  local label=$1 raw=$2
  local dst
  dst=$(realpath -m "$raw")
  case "$dst" in
    "$TMP_REAL"/*|"$TMP_REAL") ;;
    *) echo "❌ ${label} 經 symlink 指出暫存樹外（$dst），拒絕" >&2; exit 1 ;;
  esac
  printf '%s\n' "$dst"
}
cleanup() {
  rm -rf "${TMP:?}" 2>/dev/null || true
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# 匯出「目前 index」的完整樹（含已暫存變更，不含未暫存的工作目錄改動）
git checkout-index --all --prefix="$TMP/"

# --- gitleaks：先掃暫存樹（尚未接上 node_modules，避免掃到依賴）＋本 repo 歷史 ---
VER=8.21.2
SHA=5bc41815076e6ed6ef8fbecc9d9b75bcae31f39029ceb55da08086315316e3ba
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/semantic-defense/gitleaks-$VER"
GL="$CACHE/gitleaks"
if [ ! -x "$GL" ]; then
  mkdir -p "$CACHE"
  tgz="$CACHE/gl.tgz"
  for i in 1 2 3; do
    curl -fsSL --retry 2 -o "$tgz" \
      "https://github.com/gitleaks/gitleaks/releases/download/v$VER/gitleaks_${VER}_linux_x64.tar.gz" \
      && break
    sleep 2
  done
  echo "$SHA  $tgz" | sha256sum -c --quiet - || { echo "❌ gitleaks 下載校驗失敗"; rm -f "$tgz"; exit 1; }
  tar xzf "$tgz" -C "$CACHE" gitleaks && rm -f "$tgz"
fi
"$GL" dir "$TMP" --no-banner --redact -v --exit-code 1 --max-target-megabytes 5 2>&1 | grep -v node_modules || true
"$GL" dir "$TMP" --no-banner --redact --exit-code 1 >/dev/null 2>&1
if git -C "$ROOT" rev-parse HEAD >/dev/null 2>&1; then
  "$GL" git "$ROOT" --no-banner --redact --exit-code 1
fi
echo "secrets: OK"

# 接上依賴（gitleaks 之後）：
# - 根目錄 node_modules：symlink（體積大、.pnpm store）
# - packages/*/apps/*/node_modules：cp -a 複製，保留相對連結，使其解析到 $TMP 內的
#   packages/*（若 symlink 過去，相對路徑會指回工作目錄的 src，index 隔離就失效）
# 寫入前一律 realpath 確認未逃出 $TMP_REAL（index 若含 packages→樹外 symlink 會被擋下）
if [ -d "$ROOT/node_modules" ]; then
  nm_dst=$(assert_under_tmp "node_modules" "$TMP/node_modules")
  if [ -L "$TMP/node_modules" ]; then
    rm -f "$TMP/node_modules"
  elif [ -e "$TMP/node_modules" ]; then
    rm -rf "${nm_dst:?}"
  fi
  ln -s "$ROOT/node_modules" "$TMP/node_modules"
fi
for d in "$ROOT"/packages/*/node_modules "$ROOT"/apps/*/node_modules; do
  [ -e "$d" ] || continue
  rel=${d#"$ROOT"/}
  case "$rel" in
    /*|*".."*) echo "❌ 非法相對路徑 rel=$rel（來自 $d）" >&2; exit 1 ;;
  esac
  dst=$(assert_under_tmp "$rel" "$TMP/$rel")
  parent=$(assert_under_tmp "$(dirname "$rel")" "$TMP/$(dirname "$rel")")
  mkdir -p "$parent"
  rm -rf "${dst:?}"
  cp -a "$d" "$dst"
  # 排除 Vite 快取（若有）
  if [ -e "$dst/.vite" ] || [ -L "$dst/.vite" ]; then
    vite_dst=$(assert_under_tmp "$rel/.vite" "$dst/.vite")
    rm -rf "${vite_dst:?}"
  fi
done

# --- typecheck / eslint：在暫存樹內跑，看不到工作目錄未暫存改動 ---
echo "pre-commit: 型別檢查（index）"
( cd "$TMP" && pnpm run -s typecheck )
echo "pre-commit: eslint（index）"
( cd "$TMP" && pnpm run -s lint --max-warnings=0 )
echo "pre-commit: OK"
